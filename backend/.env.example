# Optional — without either of these, the service still runs end-to-end
# using only the mock-seedance provider (both real providers fail over
# immediately). Set one or both; they're tried in this order:
# gemini-openrouter -> openai-images -> mock-seedance.
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# OpenRouter pre-authorises max_tokens worth of credit *before* generating,
# and defaults to the model's full context ceiling (~29k tokens) when this is
# unset — so a low-balance account gets HTTP 402 even though one image only
# costs ~1290 completion tokens. Keep this just above the cost of one image.
OPENROUTER_MAX_TOKENS=2000

# Image generation is much slower than a text completion. Too low a value and
# the request times out, the provider chain fails over, and jobs silently come
# back from the mock provider instead.
PROVIDER_TIMEOUT_SECONDS=90

# Postgres in production/docker-compose; defaults to a local SQLite file.
# DATABASE_URL=postgresql+psycopg2://mediaops:mediaops@localhost:5432/mediaops

AUTO_APPROVE_THRESHOLD_CENTS=100
QA_IDENTITY_THRESHOLD=70
QA_BRAND_THRESHOLD=60
CORS_ORIGINS=http://localhost:5173

# Optional — POSTs a JSON payload to this URL on every job status change.
# Point it at an n8n Webhook trigger node (or Slack, or anything else).
WEBHOOK_URL=

# Optional — requires X-API-Key on every endpoint except /health and
# /outputs when set. Empty (default) = no auth, fine for local dev only.
API_KEY=
