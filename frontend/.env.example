# Only needed if the backend has API_KEY set (backend/.env.example) —
# otherwise the backend has no auth requirement and this can stay unset.
VITE_API_KEY=

# Only needed when frontend and backend are deployed as separate services
# (e.g. two Cloud Run services). Leave unset for local dev — vite.config.ts
# proxies /api and /outputs to the backend on :8000 instead. Baked in at
# build time, not runtime (it's a Vite env var).
VITE_API_BASE_URL=
